# ==========================================
# NCC BATTALION MANAGEMENT SYSTEM - ENV TEMPLATE
# ==========================================

# Database Connection (PostgreSQL Pooler URI)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:6543/postgres

# Core API Security & JWT
SECRET_KEY=your-super-secret-jwt-signing-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,*

# Supabase Cloud Project Configuration
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=<supabase-service-role-or-jwt-secret>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_ANON_KEY=<supabase-anon-key>

# Frontend / Vite Client Configuration
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
